<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

        {# Bootstrap 5 CSS via CDN (par défaut) - tu peux remplacer par une intégration locale si nécessaire #}
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
            <style>
                /* Image de fond (placer le fichier dans public/images/background.jpg) */

                body {
                    position: relative;
                    min-height: 100vh;
                }
                body::before {
                    content: "";
                    position: fixed;
                    top: 0; left: 0; right: 0; bottom: 0;
                    z-index: -1;
                    background-image: url('/images/background.jpg');
                    background-size: cover;
                    background-repeat: no-repeat;
                    background-attachment: fixed;
                    background-position: center center;
                    opacity: 0.6;
                }

                /* Conteneur principal légèrement opaque pour améliorer la lisibilité */
                .main-content {
                    /*background-color: rgba(235, 195, 210, 0.3); /* Couleur rose pâle avec opacité */
                    padding: 1.5rem;
                    border-radius: .5rem;
                }

                /* Styles de la navbar */
                .navbar {
                    background: linear-gradient(135deg, rgba(235, 195, 210, 0.95) 0%, rgba(220, 180, 200, 0.95) 100%) !important;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                    backdrop-filter: blur(10px);
                }

                .navbar-brand {
                    font-weight: 700;
                    font-size: 1.5rem;
                    color: #6b2c4f !important;
                    text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.3);
                    transition: transform 0.3s ease;
                }

                .navbar-brand:hover {
                    transform: scale(1.05);
                }

                .nav-link {
                    font-weight: 500;
                    color: #5a2342 !important;
                    padding: 0.5rem 1rem !important;
                    margin: 0 0.25rem;
                    border-radius: 0.5rem;
                    transition: all 0.3s ease;
                    position: relative;
                }

                .nav-link:hover {
                    background-color: rgba(255, 255, 255, 0.4);
                    transform: translateY(-2px);
                }

                .nav-link.active {
                    background-color: rgba(107, 44, 79, 0.15);
                    font-weight: 600;
                }

                .nav-link.active::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 80%;
                    height: 3px;
                    background-color: #6b2c4f;
                    border-radius: 2px;
                }

                .navbar-text {
                    color: #5a2342 !important;
                    font-weight: 500;
                }

                .btn-outline-secondary {
                    border-color: #6b2c4f;
                    color: #6b2c4f;
                    font-weight: 500;
                    transition: all 0.3s ease;
                }

                .btn-outline-secondary:hover {
                    background-color: #6b2c4f;
                    border-color: #6b2c4f;
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 8px rgba(107, 44, 79, 0.3);
                }

                .navbar-toggler {
                    border-color: #6b2c4f;
                }

                .navbar-toggler-icon {
                    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%236b2c4f' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
                }
            </style>
        {% endblock %}
        {# Importmap / autres scripts dans le head (conserve l'importmap existant) #}
        {% block javascripts %}
            {# {% block importmap %}{{ importmap('app') }}{% endblock %} #}
        {% endblock %}
    </head>
    <body>
        {# Barre de navigation de base utilisant Bootstrap 5 #}
        <header>
            <nav class="navbar navbar-expand-lg">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">Le Repère des Protocoles</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        {% set current_route = app.request.attributes.get('_route') %}

                        {# Liens à gauche #}
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link {% if current_route == 'app_about' %}active{% endif %}"
                                   href="{{ path('app_about') }}">Qui sommes nous ?</a>
                            </li>
                            {% if app.user %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        <a class="nav-link {% if current_route is defined and (current_route == 'app_domaine_index' or current_route starts with('app_domaine')) %}active{% endif %}" href="{{ path('app_domaine_index') }}">Domaines</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link {% if current_route is defined and (current_route == 'app_rubrique_index' or current_route starts with('app_rubrique')) %}active{% endif %}" href="{{ path('app_rubrique_index') }}">Rubriques</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link {% if current_route is defined and (current_route == 'app_theme_index' or current_route starts with('app_theme')) %}active{% endif %}" href="{{ path('app_theme_index') }}">Thèmes</a>
                                    </li>
                                {% endif %}
                                <li class="nav-item">
                                    <a class="nav-link {% if current_route is defined and (current_route == 'app_protocole_index' or current_route starts with('app_protocole')) %}active{% endif %}" href="{{ path('app_protocole_index') }}">Protocoles</a>
                                </li>
                            {% endif %}
                        </ul>
                        
                        <ul class="navbar-nav ms-auto">
                            {% if app.user %}
                                <li class="nav-item d-flex align-items-center">
                                    <span class="navbar-text me-3">
                                        Bienvenue, {{ app.user.prenom }}
                                    </span>
                                    <a class="btn btn-outline-secondary" role="button" href="{{ path('app_logout') }}">Se déconnecter</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="btn btn-outline-secondary ms-2" role="button" href="{{ path('app_login') }}">Se connecter</a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="container-fluid my-4">
            <div class="main-content">
                {% block body %}{% endblock %}
            </div>
        </main>

        {# Scripts JS de Bootstrap (bundle inclut Popper) - placé avant la fermeture body #}
        {% block body_javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </body>
</html>
