{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block stylesheets %}
    {{ parent() }}
        <style>
            .login-wrapper {
                min-height: calc(100vh - 200px);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 1rem;
            }
            .login-card {
                width: 100%;
                max-width: 420px;
            }

            .login-wrapper .form-control:hover,
            .login-wrapper input:hover,
            .login-wrapper textarea:hover,
            .login-wrapper select:hover {
                cursor: pointer;
            }

            .text-center a:hover {
                    color: #5a3a5a;
                }
            
            .text-center a {
                color: rgba(200, 150, 180, 0.8);
                text-decoration: none;
                font-weight: 600;
                transition: all 0.3s ease;
                position: relative;
            }

            .text-center a::after {
                content: '';
                position: absolute;
                bottom: -3px;
                left: 0;
                width: 0;
                height: 2px;
                background-color: rgba(200, 150, 180, 0.8);
                transition: width 0.3s ease;
            }

            .text-center a:hover::after {
                width: 100%;
            }

            .login-wrapper .btn-outline-secondary {
                border: 2px solid rgba(200, 150, 180, 0.8);
                color: #5a3a5a;
                font-weight: 600;
                transition: all 0.3s ease;
            }

            .login-wrapper .btn-outline-secondary:hover {
                background-color: rgba(200, 150, 180, 0.8);
                border-color: rgba(200, 150, 180, 0.8);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
            }

            .login-wrapper .btn-outline-secondary:active {
                transform: translateY(0);
            }

            .login-wrapper .form-control:focus {
                border-color: rgba(200, 150, 180, 0.8);
                box-shadow: 0 0 0 0.2rem rgba(200, 150, 180, 0.25);
                outline: none;
            }
        </style>
{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="col-md-4">
        <div class="card shadow rounded-4">
            <div class="card-body p-4 bg-light rounded-4">
                <form method="post">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3">
                            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                        </div>
                    {% endif %}

                    <h1 class="h3 mb-3 font-weight-normal text-center">Veuillez vous connecter</h1>
                    
                    <div class="mb-3">
                        <label for="username" class="form-label">Email</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                    </div>
                    
                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                    </div>
                    
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid">
                        <button class="btn btn-lg btn-outline-secondary" type="submit">
                            Se connecter
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <p class="mb-0">Vous n'avez pas encore de compte ? <a href="">S'enregistrer</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}