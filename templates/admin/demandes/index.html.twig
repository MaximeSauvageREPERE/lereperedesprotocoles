{% extends 'base.html.twig' %}

{% block title %}Demandes d'inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .btn-success {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-success:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
        .btn-success:active,
        .btn-success:focus,
        .btn-success:focus-visible {
            background-color: rgba(90, 58, 90, 0.8) !important;
            border-color: rgba(200, 150, 180, 0.8) !important;
            color: #fff !important;
            transform: translateY(0);
        }
        
        .table .btn-outline-danger,
        .table .btn-outline-success {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .table .btn-outline-danger:hover,
        .table .btn-outline-success:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }

        .table {
            background-color: #f5e6f0;
            border: 1px solid rgba(90, 58, 90, 0.3);
        }

        .table .badge {
            background-color: #ebc3d2cc !important;
            color: #5a3a5a !important;
            border: 1px solid rgba(90, 58, 90, 0.3);
        }
        
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 p-3">
        <h1 class="mb-0">Demandes d'inscription</h1>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-hover table-striped align-middle shadow-sm rounded overflow-hidden rounded-4">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">ID</th>
                            <th class="text-center">Nom</th>
                            <th class="text-center">Prénom</th>
                            <th class="text-center">Email</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Créée le</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for d in demandes %}
                        <tr>
                            <td class="text-center">{{ d.id }}</td>
                            <td class="text-center">{{ d.nom }}</td>
                            <td class="text-center">{{ d.prenom }}</td>
                            <td class="text-center">{{ d.email }}</td>
                            <td class="text-center">
                                {% if d.status == 'pending' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif d.status == 'accepted' %}
                                    <span class="badge bg-success">Acceptée</span>
                                {% else %}
                                    <span class="badge bg-danger">Refusée</span>
                                {% endif %}
                            </td>
                            <td class="text-center text-nowrap">{{ d.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="text-center">
                                <div class="d-flex flex-row justify-content-center align-items-center gap-1">
                                    {% if d.status == 'pending' %}
                                        <a href="{{ path('admin_demande_accepter', {'id': d.id}) }}" class="btn btn-outline-success btn-sm">Valider</a>
                                        <a href="{{ path('admin_demande_refuser', {'id': d.id}) }}" class="btn btn-outline-danger btn-sm">Refuser</a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center fst-italic">Aucune demande trouvée</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}