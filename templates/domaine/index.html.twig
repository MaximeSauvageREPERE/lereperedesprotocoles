{% extends 'base.html.twig' %}

{% block title %}Liste des Domaines{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .btn-success {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: rgba(235, 195, 210, 0.35);
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-success:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
        .btn-success:active,
        .btn-success:focus,
        .btn-success:focus-visible {
            background-color: rgba(90, 58, 90, 0.8) !important;
            border-color: rgba(200, 150, 180, 0.8) !important;
            color: #fff !important;
            transform: translateY(0);
        }

        .table .btn-outline-danger,
        .table .btn-outline-warning {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .table .btn-outline-danger:hover,
        .table .btn-outline-warning:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }

        .table {
            background-color: #f5e6f0;
            border: 1px solid rgba(90, 58, 90, 0.3);
        }
        
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3 p-3">
                <h1 class="mb-0">Liste des domaines</h1>
                <a href="{{ path('app_domaine_new') }}" class="btn btn-success">Ajouter un domaine</a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped align-middle shadow-sm rounded overflow-hidden rounded-4">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Nom</th>
                            <th class="text-center">Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for domaine in domaines %}
                        <tr>
                            <td class="text-center">{{ domaine.nom }}</td>
                            <td class="text-center">{{ domaine.description }}</td>
                            <td class="text-center">
                                <div class="d-flex flex-row justify-content-center align-items-center gap-1">
                                    <a href="{{ path('app_domaine_edit', {'id': domaine.id}) }}" class="btn btn-outline-warning">Modifier</a>
                                    {{ include('domaine/_delete_form.html.twig', { 'domaine': domaine }) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center fst-italic">Aucun domaine trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}