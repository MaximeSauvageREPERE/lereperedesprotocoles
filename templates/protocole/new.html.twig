{% extends 'base.html.twig' %}

{% block title %}Nouveau Protocole{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3 p-3">
                <h1 class="mb-0">Créer un nouveau protocole</h1>
                <a href="{{ path('app_protocole_index') }}" class="btn btn-secondary">Retour à la liste</a>
            </div>
            <div class="card shadow-sm mb-4 bg-light rounded-4">
                <div class="card-body">
                    {{ include('protocole/_form.html.twig', {'button_label': 'Créer'}) }}
                </div>
                <div class="card-footer d-flex justify-content-end gap-2 bg-light rounded-4 border-0">
                    <button type="submit" form="protocole_form" class="btn btn-outline-primary">Créer</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}