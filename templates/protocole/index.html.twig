{% extends 'base.html.twig' %}

{% block title %}Liste des Protocoles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .pagination { gap: .35rem; }
        .pagination .page-link {
            padding: .55rem 1.05rem;
            font-size: 0.95rem;
            color: #5a3a5a;
            background-color: #ebc3d2cc;
            border: 1px solid rgb(90, 58, 90, 0.7);
            box-shadow: 0 2px 6px rgba(90, 58, 90, 0.7);
            transition: all .15s ease;
            border-radius: 999px;
        }

        .pagination .page-item:first-child .page-link,
        .pagination .page-item:last-child .page-link {
            border-radius: 999px;
        }
        .pagination .page-link:hover {
            background-color: #5a3a5a;
            color: #fff;
            border-color: #495057;
        }
        .pagination .page-item.active .page-link {
            background-color: #5a3a5a;
            border-color: rgb(90, 58, 90);
            color: #ffffff;
            box-shadow: 0 3px 10px rgba(90, 58, 90, 0.7);
        }
        .pagination .page-item.disabled .page-link {
            color: rgb(133, 136, 139, 0.7);
            background-color: #ebc3d2cc;
            border-color: rgb(90, 58, 90, 0.4);
            box-shadow: none;
        }

        /* Filtres : selects */
        .form-select {
            background-color: #f5e6f0 !important;
            border: 1px solid #d9b3d4 !important;
            color: #5a3a5a;
        }
        .form-select:focus {
            background-color: #f5e6f0 !important;
            border-color: #5a3a5a !important;
            box-shadow: 0 0 0 0.2rem rgba(90, 58, 90, 0.40);
        }

        .btn-outline-primary,
        .btn-outline-secondary {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-outline-primary:hover,
        .btn-outline-secondary:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }

        .btn-outline-primary:active,
        .btn-outline-primary:focus,
        .btn-outline-primary:focus-visible,
        .btn-outline-secondary:active,
        .btn-outline-secondary:focus,
        .btn-outline-secondary:focus-visible {
            background-color: rgba(90, 58, 90, 0.8) !important;
            border-color: rgba(200, 150, 180, 0.8) !important;
            color: #fff !important;
            transform: translateY(0);
        }

        .btn-success {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-success:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
        .btn-success:active,
        .btn-success:focus,
        .btn-success:focus-visible {
            background-color: rgba(90, 58, 90, 0.8) !important;
            border-color: rgba(200, 150, 180, 0.8) !important;
            color: #fff !important;
            transform: translateY(0);
        }

        /* Card rose pour les filtres */
        .card-rose {
            background-color: rgba(235, 195, 210, 0.9) !important;
            border: 1px solid rgba(90, 58, 90, 0.7);
        }
        .card-rose .card-footer {
            background-color: transparent !important;
        }

        /* Tableau : fond rose pâle */
        .table {
            background-color: #f5e6f0;
            border: 1px solid rgba(90, 58, 90, 0.3);
        }

        /* Badges dans le tableau */
        .table .badge.bg-light {
            background-color: #ebc3d2cc !important;
            color: #5a3a5a !important;
            border: 1px solid rgba(90, 58, 90, 0.3);
        }

        .table .btn-outline-primary,
        .table .btn-outline-warning {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: transparent;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .table .btn-outline-primary:hover,
        .table .btn-outline-warning:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
    </style>
{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-3 p-3">
        <h1 class="mb-0">Liste des protocoles</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_protocole_new') }}" class="btn btn-success">Ajouter un protocole</a>
        {% endif %}
    </div>

    {# Filtres #}
    <div class="card mb-4 shadow-sm rounded-4 card-rose">
        <div class="card-body">
            <form method="get" action="{{ path('app_protocole_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="domaine" class="form-label">Domaine</label>
                    <select name="domaine" id="domaine" class="form-select">
                        <option value="">Tous les domaines</option>
                        {% for domaine in domaines %}
                            <option value="{{ domaine.id }}" {% if selectedDomaine == domaine.id %}selected{% endif %}>{{ domaine.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="rubrique" class="form-label">Rubrique</label>
                    <select name="rubrique" id="rubrique" class="form-select">
                        <option value="">Toutes les rubriques</option>
                        {% for rubrique in rubriques %}
                            <option value="{{ rubrique.id }}" {% if selectedRubrique == rubrique.id %}selected{% endif %}>{{ rubrique.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="theme" class="form-label">Thème</label>
                    <select name="theme" id="theme" class="form-select">
                        <option value="">Tous les thèmes</option>
                        {% for theme in themes %}
                            <option value="{{ theme.id }}" {% if selectedTheme == theme.id %}selected{% endif %}>{{ theme.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-outline-primary">Filtrer</button>
                    <a href="{{ path('app_protocole_index') }}" class="btn btn-outline-secondary">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive mb-4">
        <table class="table table-bordered table-hover table-striped align-middle shadow-sm rounded overflow-hidden rounded-4">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">Nom</th>
                    <th class="text-center">Thème associé</th>
                    <th class="text-center">Rubrique associé</th>
                    <th class="text-center">Domaine associé</th>
                    <th class="text-center">Fichier</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for protocole in protocoles %}
                <tr>
                    <td class="text-center">{{ protocole.nom }}</td>
                    <td class="text-center align-middle">
                        {% if protocole.theme %}
                            <span class="badge bg-light text-dark">{{ protocole.theme.nom }}</span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="text-center align-middle">
                        {% if protocole.theme and protocole.theme.rubrique %}
                            <span class="badge bg-light text-dark">{{ protocole.theme.rubrique.nom }}</span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="text-center align-middle">
                        {% if protocole.theme and protocole.theme.rubrique and protocole.theme.rubrique.domaines is not empty %}
                            {% for domaine in protocole.theme.rubrique.domaines %}
                                <span class="badge bg-light text-dark">{{ domaine.nom }}</span>
                            {% endfor %}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {% if protocole.fichier %}
                            <a href="{{ vich_uploader_asset(protocole, 'pdfFile') }}" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-file-pdf"></i> PDF
                            </a>
                        {% else %}
                            <span class="text-muted">Aucun fichier</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <div class="d-flex flex-row justify-content-center align-items-center gap-1">
                            <a href="{{ path('app_protocole_show', {'id': protocole.id}) }}" class="btn btn-outline-primary">Voir</a>
                                <a href="{{ path('app_protocole_edit', {'id': protocole.id}) }}" class="btn btn-outline-warning">Modifier</a>
                                {{ include('protocole/_delete_form.html.twig', { 'protocole': protocole }) }}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center fst-italic">Aucun protocole trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <nav aria-label="Page navigation" class="d-flex justify-content-center mb-4">
    {{ knp_pagination_render(protocoles, 'pagination/bootstrap_v5_pagination_fr.html.twig') }}
    </nav>

{% endblock %}