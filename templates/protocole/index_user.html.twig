{% extends 'base.html.twig' %}

{% block title %}Protocoles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .pagination { gap: .35rem; }
        .pagination .page-link {
            padding: .55rem 1.05rem;   /* augmenté */
            font-size: 0.95rem;        /* légèrement plus grand */
            color: #5a3a5a;
            background-color: #ebc3d2cc;
            border: 1px solid rgb(90, 58, 90, 0.7);
            box-shadow: 0 2px 6px rgba(90, 58, 90, 0.7);
            transition: all .15s ease;
            border-radius: 999px;
        }

        .pagination .page-item:first-child .page-link,
        .pagination .page-item:last-child .page-link {
            border-radius: 999px;
        }
        .pagination .page-link:hover {
            background-color: #5a3a5a;
            color: #fff;
            border-color: #495057;
        }
        .pagination .page-item.active .page-link {
            background-color: #5a3a5a;
            border-color: rgb(90, 58, 90);
            color: #ffffff; /* BLANC SUR FOND VIOLET */
            box-shadow: 0 3px 10px rgba(90, 58, 90, 0.7);
        }
        .pagination .page-item.disabled .page-link {
            color: rgb(133, 136, 139, 0.7);
            background-color: #ebc3d2cc;
            border-color: rgb(90, 58, 90, 0.4);
            box-shadow: none;
        }

        .card {
            background-color: rgba(235, 195, 210, 0.9) !important;
            border: 1px solid rgb(90, 58, 90, 0.7);
        }

        .card-footer {
            background-color: transparent !important;
        }

        .form-select {
            background-color: #f5e6f0 !important;
            border: 1px solid #d9b3d4 !important;
            color: #5a3a5a;
        }
        .form-select:focus {
            background-color: #f5e6f0 !important;
            border-color: #5a3a5a !important;
            box-shadow: 0 0 0 0.2rem rgba(90, 58, 90, 0.40);
        }

        .btn-card-voir {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
           background-color: #f5e6f0;
            font-weight: 600;
            transition: all 0.3s ease;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
        }
        .btn-card-voir:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
        .btn-card-voir:active {
            transform: translateY(0);
        }

        .btn-outline-primary-filtre,
        .btn-outline-secondary-filtre {
            border: 2px solid rgba(200, 150, 180, 0.8);
            color: #5a3a5a;
            background-color: #f5e6f0;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-outline-primary-filtre:hover,
        .btn-outline-secondary-filtre:hover {
            background-color: rgba(90, 58, 90, 0.8);
            border-color: rgba(200, 150, 180, 0.8);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(200, 150, 180, 0.3);
        }
        .btn-outline-primary-filtre:active,
        .btn-outline-secondary-filtre:active {
            transform: translateY(0);
        }

    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4 text-center">Liste des Protocoles</h1>
        
        {# Filtres #}
        <div class="card mb-4 shadow-sm bg-light rounded-4">
            <div class="card-body">
                <form method="get" action="{{ path('app_protocole_index') }}" class="row g-3">
                    <div class="col-md-4">
                        <label for="domaine" class="form-label">Domaine</label>
                        <select name="domaine" id="domaine" class="form-select">
                            <option value="">Tous les domaines</option>
                            {# Ajouter les options dynamiquement via le contrôleur #}
                            {% for domaine in domaines %}
                                <option value="{{ domaine.id }}" {% if selectedDomaine == domaine.id %}selected{% endif %}>{{ domaine.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="rubrique" class="form-label">Rubrique</label>
                        <select name="rubrique" id="rubrique" class="form-select">
                            <option value="">Toutes les rubriques</option>
                            {# Ajouter les options dynamiquement via le contrôleur #}
                            {% for rubrique in rubriques %}
                                <option value="{{ rubrique.id }}" {% if selectedRubrique == rubrique.id %}selected{% endif %}>{{ rubrique.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="theme" class="form-label">Thème</label>
                        <select name="theme" id="theme" class="form-select">
                            <option value="">Tous les thèmes</option>
                            {# Ajouter les options dynamiquement via le contrôleur #}
                            {% for theme in themes %}
                                <option value="{{ theme.id }}" {% if selectedTheme == theme.id %}selected{% endif %}>{{ theme.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-outline-primary-filtre">Filtrer</button>
                        <a href="{{ path('app_protocole_index') }}" class="btn btn-outline-secondary-filtre">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </div>
        
        {# Cards des protocoles #}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            {% for protocole in protocoles %}
                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4 bg-light">
                        <div class="card-body">
                            <h5 class="card-title mb-2">{{ protocole.nom }}</h5>
                            {% if protocole.theme and protocole.theme.rubrique %}
                                <p class="card-text"><span class="badge bg-black">Rubrique : {{ protocole.theme.rubrique.nom }}</span></p>
                            {% endif %}
                            {% if protocole.theme %}
                                <p class="card-text"><small class="text-muted">Thème : {{ protocole.theme.nom }}</small></p>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-light border-0 d-flex justify-content-end rounded-4 gap-2">
                            <a href="{{ path('app_protocole_show', {'id': protocole.id}) }}" class="btn btn-sm btn-card-voir">Voir</a>
                            {% if protocole.fichier %}
                                <a href="{{ vich_uploader_asset(protocole, 'pdfFile') }}" target="_blank" class="btn btn-sm btn-outline-secondary">PDF</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-center text-muted fst-italic">Aucun protocole disponible.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <nav aria-label="Page navigation" class="d-flex justify-content-center mb-4">
    {{ knp_pagination_render(protocoles, 'pagination/bootstrap_v5_pagination_fr.html.twig') }}
    </nav>

{% endblock %}